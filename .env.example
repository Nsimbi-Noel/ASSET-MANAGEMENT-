# Server
# NOTE: this must match the default in server.js (3000), the Dockerfile and CI.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database (default: ./data/database.db)
DB_PATH=

# Bootstrap accounts
# These are used ONCE, when seeding an empty database. They are mandatory when
# NODE_ENV=production — startup aborts if any is missing or shorter than
# PASSWORD_MIN_LENGTH (6). Outside production, omitting them falls back to
# development-only defaults and logs a warning.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_MANAGER_PASSWORD=
BOOTSTRAP_EMPLOYEE_PASSWORD=

# Password shared by the accounts created by `npm run seed`.
# Also mandatory when NODE_ENV=production. Rotate these accounts before any
# real use — they exist to populate demo data.
SEED_USER_PASSWORD=

# Session lifetime in milliseconds (default: 86400000 = 24h)
SESSION_TTL_MS=

# Maximum accepted request body size in bytes (default: 1048576 = 1 MB)
MAX_BODY_SIZE=

# SSL/TLS (optional — set both for HTTPS)
SSL_KEY_PATH=
SSL_CERT_PATH=

# Rate Limiting (login endpoint)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_LOGIN=10
